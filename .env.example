# ===========================
# AI ARBITER - Environment Configuration Template
# ===========================

# === GOOGLE AI API KEY (REQUIRED) ===
# Get your key from: https://aistudio.google.com/app/apikey
# This key works for: Gemini API, YouTube Data API v3
GEMINI_API_KEY=your_gemini_api_key_here

# === DEPLOYMENT MODE ===
# Set to 'true' for production (uses backend API)
# Set to 'false' for development (client-side Gemini calls)
VITE_USE_API_ENDPOINT=false

# === API ENDPOINT (Required when VITE_USE_API_ENDPOINT=true) ===
# Example for Vercel: https://your-project.vercel.app
# Example for Netlify: https://your-project.netlify.app
VITE_API_BASE_URL=http://localhost:3000

# === DATABASE (Optional - for gamification persistence) ===
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# === SOCIAL MEDIA APIS (Optional) ===
# YouTube API already works with GEMINI_API_KEY above
# Instagram requires separate OAuth setup:
INSTAGRAM_APP_ID=your_facebook_app_id
INSTAGRAM_APP_SECRET=your_facebook_app_secret

# === RAG SYSTEM (Optional - enhanced configuration) ===
# Not required for basic URL fetching (default implementation)
# Only needed if using embeddings/vector search
LANGCHAIN_API_KEY=your_langchain_api_key
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=ai-arbiter-debates

# === ADDITIONAL FEATURES (Optional) ===
# Manim video generation (if implementing Python bridge)
MANIM_RENDER_ENDPOINT=https://your-manim-service.com/render

# ===========================
# QUICK START:
# 1. Copy this file: cp .env.example .env.local
# 2. Get Gemini API key from https://aistudio.google.com/app/apikey
# 3. Replace "your_gemini_api_key_here" with your real key
# 4. Run: npm run dev
# ===========================
