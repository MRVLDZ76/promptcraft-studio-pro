# ===========================
# AI ARBITER - Environment Configuration Template
# ===========================

# === GOOGLE AI API KEY (REQUIRED) ===
# Get your key from: https://aistudio.google.com/app/apikey
# This key works for: Gemini API, YouTube Data API v3
GEMINI_API_KEY=your_gemini_api_key_here

# === DEPLOYMENT MODE ===
# Set to 'true' for production (uses backend API)
# Set to 'false' for development (client-side Gemini calls)
VITE_USE_API_ENDPOINT=false

# === API ENDPOINT (Required when VITE_USE_API_ENDPOINT=true) ===
# Example for Vercel: https://promptcraft-studio-pro.vercel.app
# Example for Netlify: https://your-project.netlify.app
VITE_API_BASE_URL=http://localhost:3000

# === SERPAPI KEY (Required for YouTube search & transcripts) ===
# Get your key from: https://serpapi.com/
# Features:
# - YouTube video/channel search
# - YouTube transcript extraction (99% cost savings vs video processing)
# - Cost comparison: Video processing $2-6 per 20min | Transcript $0.008
VITE_SERPAPI_KEY=your_serpapi_key_here

# === DATABASE (Optional - for gamification persistence) ===
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# === SOCIAL MEDIA APIS (Optional) ===
# YouTube API already works with GEMINI_API_KEY above
# Instagram requires separate OAuth setup:
INSTAGRAM_APP_ID=your_facebook_app_id
INSTAGRAM_APP_SECRET=your_facebook_app_secret

# === RAG SYSTEM (ENHANCED - Phase 1 Implementation) ===
# EMBEDDING PROVIDER: Choose "openai" (better accuracy) or "google" (cheaper)
EMBEDDING_PROVIDER=openai

# OPENAI API KEY (Required if EMBEDDING_PROVIDER=openai)
# Get from: https://platform.openai.com/api-keys
# Model: text-embedding-3-small (1536 dimensions, $0.00002/1K tokens)
OPENAI_API_KEY=sk-your-openai-key-here

# TAVILY API KEY (Required for web search & fact-checking)
# Get from: https://tavily.com/
# Free tier: 1000 searches/month | Cost: $0.001/search
TAVILY_API_KEY=tvly-your-tavily-key-here
VITE_TAVILY_API_KEY=tvly-your-tavily-key-here

# Vector search configuration (optional)
VECTOR_SIMILARITY_THRESHOLD=0.7
MAX_SEARCH_RESULTS=5
AUTO_SEARCH_ENABLED=true

# Legacy RAG keys (deprecated - not needed for new LangChain implementation)
# LANGCHAIN_API_KEY=your_langchain_api_key
# PINECONE_API_KEY=your_pinecone_api_key
# PINECONE_INDEX_NAME=ai-arbiter-debates

# === ADDITIONAL FEATURES (Optional) ===
# Manim video generation (if implementing Python bridge)
MANIM_RENDER_ENDPOINT=https://your-manim-service.com/render

# ===========================
# QUICK START:
# 1. Copy this file: cp .env.example .env.local
# 2. Get Gemini API key from https://aistudio.google.com/app/apikey
# 3. Replace "your_gemini_api_key_here" with your real key
# 4. Run: npm run dev
# ===========================
