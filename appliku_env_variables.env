# ============================================================================
# APPLIKU SERVICES CONFIGURATION
# ============================================================================
# These services are configured in appliku.yml and will run automatically:
#
# Release (runs on each deployment):
#   python manage.py migrate --noinput && python manage.py collectstatic --noinput --clear
#
# Web (scale: 1):
#   /code/start_server.sh
#
# Worker (scale: 1):
#   celery -A config.celery_app worker --loglevel=info --concurrency=4
#
# Beat (scale: 1):
#   celery -A config.celery_app beat --loglevel=info
#
# Flower (scale: 1):
#   celery -A config.celery_app flower --port=5555
#
# Databases:
#   - studio (PostgreSQL 16)
#   - studio-redis (Redis 7)
# ============================================================================

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
# 1. Import this file via Appliku Dashboard → Environment Variables → Import from .env
# 2. Manually add these database-linked variables:
#    - DATABASE_URL → From Database: studio → connection_url
#    - REDIS_URL → From Database: studio-redis → connection_url
#    - CELERY_BROKER_URL → From Database: studio-redis → connection_url
# 3. Manually add APPLE_PRIVATE_KEY (multi-line value not supported in .env import)
# 4. Update YOUR_*_HERE placeholders with actual credentials
# 5. Go to Build Settings → Set Root Directory to "backend"
# 6. Deploy!
# ============================================================================

